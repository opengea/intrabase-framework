<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerDeprecations="true">

    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <!--
        No <coverage><report> here: with a report configured, every run on a host without a
        coverage driver (xdebug/pcov) ends with "No code coverage driver available".
        For coverage, with a driver: `composer test-coverage` (HTML in build/coverage).
    -->

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <!--
            Tests that trigger error_log() would otherwise write to the
            server's shared PHP error log and look like production incidents.
            Send them to a file in the repository (build/, ignored by git).
            Relative to the working directory: run phpunit from the repo root.
        -->
        <ini name="error_log" value="build/phpunit-error.log"/>
    </php>
</phpunit>
