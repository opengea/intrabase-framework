{
    "name": "opengea/intrabase-framework",
    "description": "Intrabase: multi-tenant PHP framework for intranets and business applications",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "intranet",
        "multi-tenant",
        "framework",
        "php"
    ],
    "homepage": "https://github.com/opengea/intrabase-framework",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Intrabase\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Intrabase\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --no-coverage",
        "analyze": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
